[Unit]
Description=OndaBaja multi-radio ECNG publisher
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ondabaja
Group=ondabaja
WorkingDirectory=/opt/ondabaja-server
Environment=HOME=/opt/ondabaja-server
Environment=PYTHONDONTWRITEBYTECODE=1
# Match server.output_root; revision state is stored inside that directory.
ReadWritePaths=/opt/ondabaja-server/public
ExecStart=/opt/ondabaja-server/.venv/bin/ondabaja-server serve --config /opt/ondabaja-server/server.local.toml
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
UMask=0022
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
LockPersonality=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
